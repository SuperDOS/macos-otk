						<string>com.apple.systemevents</string>
						<key>AEReceiverIdentifierType</key>
						<string>bundleID</string>
						<key>Allowed</key>
						<true/>
						<key>CodeRequirement</key>
						<string>identifier "com.apple.osascript" and anchor apple</string>
						<key>Comment</key>
						<string>osascript to System Events - hide-all-apps trick, CoreServicesUIAgent click loop, login items, notification clearing (JXA).</string>
						<key>Identifier</key>
