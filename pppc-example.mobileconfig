<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PPPC profile for the macOS Onboarding Toolkit (OTK).

  Pre-approves the Accessibility and Apple Events permissions OTK's
  AppleScript-driven steps need (wallpaper, default-browser auto-click,
  Notification Center clear, end-of-run restart) so they run headless without
  invisible consent prompts.

  Grants are declared for the whole execution chain - the Intune MDM agent,
  /bin/bash, /usr/bin/osascript and Terminal (manual/debug runs) - because
  macOS attributes TCC responsibility inconsistently between the process that
  launched the script and the one that actually sends the Apple Event. Each
  sender is granted toward every receiver the toolkit talks to: Finder
  (wallpaper), System Events (UI clicks, login items, JXA notification clear),
  System Settings (screen-recording consent flow) and loginwindow (the
  end-of-run restart, `«event aevtrrst»`).

  Two details that are easy to get wrong:
    - /usr/bin/osascript is a bare Mach-O with no bundle, so it MUST be
      declared with IdentifierType `path`. A `bundleID` entry for
      com.apple.osascript never matches and the grant silently does nothing.
    - loginwindow must be listed as an AEReceiver or the reboot at the end of
      an interactive run hangs on an invisible consent prompt.

  NOT covered: Screen Recording. macOS does not allow MDM to pre-grant it, so
  the toolkit opens the Screen Recording pane and asks the user instead.

  BEFORE UPLOADING TO INTUNE:
    1. Generate two fresh UUIDs (`uuidgen` on macOS, twice) and replace both
       occurrences of 00000000-0000-4000-8000-000000000001 (payload) and
       00000000-0000-4000-8000-000000000002 (profile).
    2. Replace "Example Org" / com.example.* with your organization.
    3. Upload: Intune admin center - Devices - macOS - Configuration
       profiles - Create - Templates - Custom - attach this file. Assign to
       the SAME device group as the onboarding script.
    4. Point the installer's gate at this profile: set
       PPPC_PROFILE_NAME_MATCH to a substring of the display name below,
       and/or add the payload identifier
       (com.apple.TCC.configuration-profile-policy.<your-payload-UUID>)
       to PPPC_PROFILE_IDENTIFIERS.
-->
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadDescription</key>
			<string>OTK PPPC Onboarding</string>
			<key>PayloadDisplayName</key>
			<string>OTK PPPC Onboarding</string>
			<key>PayloadIdentifier</key>
			<string>com.apple.TCC.configuration-profile-policy.00000000-0000-4000-8000-000000000001</string>
			<key>PayloadOrganization</key>
			<string>Example Org</string>
			<key>PayloadType</key>
			<string>com.apple.TCC.configuration-profile-policy</string>
			<key>PayloadUUID</key>
			<string>00000000-0000-4000-8000-000000000001</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>Services</key>
			<dict>
				<key>Accessibility</key>
				<array>
					<dict>
						<key>Allowed</key>
						<true/>
						<key>CodeRequirement</key>
						<string>identifier "com.apple.Terminal" and anchor apple</string>
						<key>Comment</key>
						<string>Terminal - used during manual / debug runs.</string>
						<key>Identifier</key>
						<string>com.apple.Terminal</string>
						<key>IdentifierType</key>
						<string>bundleID</string>
					</dict>
					<dict>
						<key>Allowed</key>
						<true/>
						<key>CodeRequirement</key>
						<string>identifier "com.microsoft.intuneMDMAgent" and anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] /* exists */ and certificate leaf[field.1.2.840.113635.100.6.1.13] /* exists */ and certificate leaf[subject.OU] = UBF8T346G9</string>
						<key>Comment</key>
						<string>Intune MDM agent - runs the onboarding script.</string>
						<key>Identifier</key>
						<string>com.microsoft.intuneMDMAgent</string>
						<key>IdentifierType</key>
						<string>bundleID</string>
					</dict>
					<dict>
						<key>Allowed</key>
						<true/>
						<key>CodeRequirement</key>
						<string>identifier "com.apple.bash" and anchor apple</string>
						<key>Comment</key>
						<string>Parent shell of the orchestrator - TCC sometimes attributes responsibility here.</string>
						<key>Identifier</key>
						<string>/bin/bash</string>
						<key>IdentifierType</key>
						<string>path</string>
					</dict>
					<dict>
						<key>Allowed</key>
						<true/>
						<key>CodeRequirement</key>
						<string>identifier "com.apple.systemevents" and anchor apple</string>
						<key>Comment</key>
						<string>System Events - the process that actually drives UI clicks (CoreServicesUIAgent default-browser button, Notification Center clear-all).</string>
						<key>Identifier</key>
						<string>com.apple.systemevents</string>
						<key>IdentifierType</key>
						<string>bundleID</string>
					</dict>
					<dict>
						<key>Allowed</key>
						<true/>
						<key>CodeRequirement</key>
						<string>identifier "com.apple.osascript" and anchor apple</string>
						<key>Comment</key>
						<string>osascript - defence-in-depth when TCC attributes the responsible process to the script interpreter. Declared by path: /usr/bin/osascript is a bare Mach-O with no bundle, so bundleID never matches.</string>
						<key>Identifier</key>
						<string>/usr/bin/osascript</string>
						<key>IdentifierType</key>
						<string>path</string>
					</dict>
				</array>
				<key>AppleEvents</key>
				<array>
					<dict>
						<key>AEReceiverCodeRequirement</key>
