	<key>PayloadDescription</key>
	<string>Pre-approves the Accessibility and Apple Events permissions required by the macOS Onboarding Toolkit so its AppleScript-driven steps (wallpaper, default-browser auto-click, Notification Center clear, end-of-run restart) run without invisible consent prompts. Screen Recording is NOT covered - macOS does not allow MDM to pre-grant it, so the toolkit opens the Screen Recording pane for the user instead.</string>
	<key>PayloadDisplayName</key>
	<string>OTK PPPC Onboarding</string>
	<key>PayloadIdentifier</key>
	<string>com.example.otk.pppc.onboarding</string>
	<key>PayloadOrganization</key>
	<string>Example Org</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>00000000-0000-4000-8000-000000000002</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>TargetDeviceType</key>
	<integer>5</integer>
</dict>
